{
    "name": "error-tracking-harness",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.7.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "install:fixtures": "for f in fixtures/*/; do (cd \"$f\" && pnpm install --frozen-lockfile --ignore-scripts); done",
        "list": "node harness/run.mjs --list",
        "test": "node harness/run.mjs",
        "install:browser": "pnpm exec playwright install chromium"
    },
    "devDependencies": {
        "playwright": "1.64.1"
    }
}
