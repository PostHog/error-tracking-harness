{
    "mode": "next",
    "bundler": "webpack",
    "tags": ["next","browser","framework"],
    "version": "16.3.8",
    "plugin": "@posthog/nextjs-config",
    "distGlobs": [
        "static/chunks/**/*.js",
        "server/**/*.js",
        "static/chunks/**/*.map",
        "server/**/*.map"
    ],
    "distIgnore": [
        "static/chunks/polyfills-*.js",
        "server/**/*-manifest.js",
        "server/**/*_client-reference-manifest.js"
    ],
    "lifecycle": {
        "workspace": { "adapter": "node-modules" },
        "build": { "argv": ["node_modules/.bin/next", "build", "--webpack"] },
        "outputs": { "root": ".next" },
        "runtime": {
            "driver": "http",
            "start": { "argv": ["node_modules/.bin/next", "start", "-p", "{port}", "-H", "127.0.0.1"] },
            "ready": { "path": "/" },
            "browser": { "page": "/client", "urlPrefix": "/_next/", "root": ".next" }
        },
        "triggers": [
            { "kind": "http", "path": "/api/throw", "expects": ["entry", "lazy"] },
            { "kind": "browser", "page": "/client", "expects": ["browser-entry", "browser-lazy"] }
        ]
    },
    "cliSelection": "edges",
    "throws": {
        "entry": {
            "file": "lib/boom.js",
            "marker": "harness:throw:entry",
            "type": "Error",
            "value": "boom from entry chunk"
        },
        "lazy": {
            "file": "lib/lazy.js",
            "marker": "harness:throw:lazy",
            "type": "LazyFailure",
            "value": "lazy chunk failed with 3 values"
        },
        "browser-entry": {
            "file": "lib/boom.js",
            "marker": "harness:throw:entry",
            "type": "Error",
            "value": "boom from entry chunk"
        },
        "browser-lazy": {
            "file": "lib/lazy.js",
            "marker": "harness:throw:lazy",
            "type": "LazyFailure",
            "value": "lazy chunk failed with 3 values"
        }
    },
    "volatileChunks": [
        "static/chunks/webpack-*.js",
        "server/webpack-runtime.js",
        "server/webpack-api-runtime.js",
        "server/app/client/page.js"
    ],
    "immutable": "static/**",
    "optionalIds": [
        "static/chunks/app/**",
        "static/chunks/next/dist/**"
    ]
}
