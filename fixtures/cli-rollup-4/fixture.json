{
    "mode": "cli",
    "bundler": "rollup",
    "tags": ["cli","rollup"],
    "version": "4.64.7",
    "lifecycle": {
        "workspace": { "adapter": "node-modules" },
        "build": { "argv": ["node_modules/.bin/rollup", "-c"] },
        "outputs": { "root": "dist" },
        "runtime": { "driver": "process" },
        "triggers": [{ "kind": "process", "command": { "argv": ["node", "dist/main.mjs"] }, "expects": ["entry", "lazy"] }]
    },
    "throws": {
        "entry": {
            "file": "src/boom.js",
            "marker": "harness:throw:entry",
            "type": "Error",
            "value": "boom from entry chunk"
        },
        "lazy": {
            "file": "src/lazy.js",
            "marker": "harness:throw:lazy",
            "type": "LazyFailure",
            "value": "lazy chunk failed with 3 values"
        }
    }
}
