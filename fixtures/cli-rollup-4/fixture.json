{
    "mode": "cli",
    "bundler": "rollup",
    "tags": ["cli","rollup"],
    "version": "4.64.7",
    "entry": "dist/main.mjs",
    "runtime": "node",
    "throws": {
        "entry": {
            "file": "src/boom.js",
            "marker": "harness:throw:entry",
            "type": "Error",
            "value": "boom from entry chunk"
        },
        "lazy": {
            "file": "src/lazy.js",
            "marker": "harness:throw:lazy",
            "type": "LazyFailure",
            "value": "lazy chunk failed with 3 values"
        }
    }
}
