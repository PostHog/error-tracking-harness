{
    "bundler": "vite",
    "version": "8.3.4",
    "plugin": "@posthog/rollup-plugin",
    "floorAlias": "posthog-rollup-plugin-floor",
    "dist": "dist",
    "distGlobs": ["**/*.js", "**/*.map"],
    "integrity": "dist/index.html",
    "runtime": { "kind": "none" },
    "throws": {
        "entry": { "file": "src/boom.js", "marker": "harness:throw:entry", "type": "Error", "value": "boom from entry chunk" },
        "lazy": { "file": "src/lazy.js", "marker": "harness:throw:lazy", "type": "LazyFailure", "value": "lazy chunk failed with 3 values" }
    }
}
