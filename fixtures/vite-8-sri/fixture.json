{
    "bundler": "vite",
    "tags": ["vite","browser","sri"],
    "version": "8.3.4",
    "plugin": "@posthog/rollup-plugin",
    "distGlobs": [
        "**/*.js",
        "**/*.map"
    ],
    "integrity": "dist/index.html",
    "lifecycle": {
        "workspace": { "adapter": "node-modules" },
        "build": { "argv": ["node_modules/.bin/vite", "build"] },
        "outputs": { "root": "dist" },
        "runtime": { "driver": "browser", "serve": "dist" },
        "triggers": [{ "kind": "browser", "page": "/index.html", "expects": ["entry", "lazy"] }]
    },
    "throws": {
        "entry": {
            "file": "src/boom.js",
            "marker": "harness:throw:entry",
            "type": "Error",
            "value": "boom from entry chunk"
        },
        "lazy": {
            "file": "src/lazy.js",
            "marker": "harness:throw:lazy",
            "type": "LazyFailure",
            "value": "lazy chunk failed with 3 values"
        }
    }
}
