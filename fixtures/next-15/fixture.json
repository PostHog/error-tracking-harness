{
    "mode": "next",
    "bundler": "webpack",
    "version": "15.5.28",
    "plugin": "@posthog/nextjs-config",
    "floorAlias": "posthog-nextjs-config-floor",
    "dist": ".next",
    "distGlobs": [
        "static/chunks/**/*.js",
        "server/**/*.js",
        "static/chunks/**/*.map",
        "server/**/*.map"
    ],
    "distIgnore": [
        "static/chunks/polyfills-*.js",
        "server/**/*-manifest.js",
        "server/**/*_client-reference-manifest.js",
        "static/chunks/app/**",
        "static/chunks/next/dist/**"
    ],
    "runtime": {
        "kind": "http",
        "start": "next start",
        "paths": [
            "/api/throw"
        ]
    },
    "cliSelection": "edges",
    "throws": {
        "entry": {
            "file": "lib/boom.js",
            "marker": "harness:throw:entry",
            "type": "Error",
            "value": "boom from entry chunk"
        },
        "lazy": {
            "file": "lib/lazy.js",
            "marker": "harness:throw:lazy",
            "type": "LazyFailure",
            "value": "lazy chunk failed with 3 values"
        }
    },
    "volatileChunks": [
        "static/chunks/webpack-*.js",
        "server/webpack-runtime.js",
        "server/webpack-api-runtime.js"
    ]
}
