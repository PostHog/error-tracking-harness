{
    "bundler": "webpack",
    "version": "5.112.0",
    "plugin": "@posthog/webpack-plugin",
    "floorAlias": "posthog-webpack-plugin-floor",
    "minPlugin": "1.7.1",
    "dist": "dist",
    "distGlobs": [
        "**/*.js",
        "**/*.map"
    ],
    "integrity": "dist/index.html",
    "runtime": {
        "kind": "browser",
        "serve": "dist",
        "page": "/index.html"
    },
    "throws": {
        "entry": {
            "file": "src/boom.js",
            "marker": "harness:throw:entry",
            "type": "Error",
            "value": "boom from entry chunk"
        },
        "lazy": {
            "file": "src/lazy.js",
            "marker": "harness:throw:lazy",
            "type": "LazyFailure",
            "value": "lazy chunk failed with 3 values"
        }
    }
}
