{
    "bundler": "webpack",
    "tags": ["webpack"],
    "version": "5.112.0",
    "plugin": "@posthog/webpack-plugin",
    "lifecycle": {
        "workspace": { "adapter": "node-modules" },
        "build": { "argv": ["node_modules/.bin/webpack"] },
        "outputs": { "root": "dist" },
        "runtime": { "driver": "process" },
        "triggers": [{ "kind": "process", "command": { "argv": ["node", "dist/main.js"] }, "expects": ["entry", "lazy"] }]
    },
    "throws": {
        "entry": {
            "file": "src/boom.js",
            "marker": "harness:throw:entry",
            "type": "Error",
            "value": "boom from entry chunk"
        },
        "lazy": {
            "file": "src/lazy.js",
            "marker": "harness:throw:lazy",
            "type": "LazyFailure",
            "value": "lazy chunk failed with 3 values"
        }
    }
}
