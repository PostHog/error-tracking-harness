{
    "bundler": "webpack",
    "tags": ["webpack"],
    "version": "5.112.0",
    "plugin": "@posthog/webpack-plugin",
    "entry": "dist/main.js",
    "runtime": "node",
    "throws": {
        "entry": {
            "file": "src/boom.js",
            "marker": "harness:throw:entry",
            "type": "Error",
            "value": "boom from entry chunk"
        },
        "lazy": {
            "file": "src/lazy.js",
            "marker": "harness:throw:lazy",
            "type": "LazyFailure",
            "value": "lazy chunk failed with 3 values"
        }
    }
}
